{
  "name": "Delete Facebook Messages",
  "short_name": "Msg Cleaner",
  "version": "3.11.0",
  "manifest_version": 3,
  "description": "Open-source browser extension to preview, delete, archive, and restore Messenger conversations.",
  "author": "andrewtryder",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png",
    "256": "icons/256.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    },
    "default_title": "Delete Facebook Messages",
    "default_popup": "src/browser_action/browser_action.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/messages*",
        "https://*.facebook.com/latest/inbox*",
        "https://*.messenger.com/*"
      ],
      "js": [
        "js/script.js"
      ],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
