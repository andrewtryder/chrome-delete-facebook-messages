{
  "update_url": "https://clients2.google.com/service/update2/crx",
  "name": "Delete Facebook Messages Fast 2026",
  "short_name": "DFMF",
  "version": "3.8.0",
  "manifest_version": 3,
  "description": "One-click delete 🗑️, archive 📂, or unarchive 🔓 all types of messages for a clutter-free conversation list. 🧹",
  "author": "andrewtryder",
  "icons": {
    "128": "icons/128.png",
    "256": "icons/256.png"
  },
  "action": {
    "default_icon": "icons/128.png",
    "default_title": "DFMF",
    "default_popup": "src/browser_action/browser_action.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/*",
        "https://*.messenger.com/*",
        "http://127.0.0.1:4173/*",
        "http://localhost:4173/*"
      ],
      "css": [
        "css/style.css"
      ],
      "js": [
        "js/jquery.min.js",
        "js/sweetAlert.min.js",
        "js/jquery-confirm.js",
        "js/script.js"
      ],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
