{
  "update_url": "https://clients2.google.com/service/update2/crx",
  "name": "Delete Facebook Messages",
  "short_name": "Msg Cleaner",
  "version": "3.9.0",
  "manifest_version": 3,
  "description": "Open-source browser extension to preview, delete, archive, and restore Messenger conversations.",
  "author": "andrewtryder",
  "icons": {
    "128": "icons/128.png",
    "256": "icons/256.png"
  },
  "action": {
    "default_icon": "icons/128.png",
    "default_title": "Delete Facebook Messages",
    "default_popup": "src/browser_action/browser_action.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/*",
        "https://*.messenger.com/*"
      ],
      "js": [
        "js/script.js"
      ],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
